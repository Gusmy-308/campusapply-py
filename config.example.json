{
  "llm": {
    "provider": "deepseek",
    "api_key": "在这里填你的 API Key",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com/v1"
  },
  "browser": {
    "headless": false,
    "profile_dir": "./chrome-profile",
